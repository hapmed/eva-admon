# Variables de entorno de la EVA (valores FICTICIOS de ejemplo).

# --- Propias de la app (prefijo EVA_) ---
EVA_ENVIRONMENT=local
EVA_DEBUG=false
EVA_PORT=8000

# Autenticación (JWT). Cambia el secreto en cada instalación.
EVA_JWT_SECRET=change-me-en-produccion
EVA_JWT_EXPIRES_MINUTES=480

# Bootstrap opcional del primer administrador (solo si no existe ningún usuario).
EVA_ADMIN_EMAIL=admin@ejemplo.com
EVA_ADMIN_PASSWORD=CambiarEsta123
EVA_ADMIN_NAME=Administrador

# Folios y consecutivos.
EVA_CLIENTE_PREFIJO=CLI-
EVA_COTIZACION_PREFIJO=COT-
EVA_CONSECUTIVO_DIGITOS=4

# Reglas por defecto.
EVA_IVA_PORCENTAJE=16
EVA_MONEDA=MXN
EVA_LOGO_DIR=./data/branding

# Carpeta del frontend compilado que sirve el backend (SPA). En la imagen = /app/static.
# EVA_STATIC_DIR=/app/static

# --- Inyectadas por EVAS Admin en producción ---
# EVAS_VERSION=0.1.0
# EVAS_EVA_CODE=admon
# EVAS_INSTALLATION_ID=<uuid>
# EVAS_CLIENT_REF=<cliente>
# DATABASE_URL=postgresql+psycopg://eva:change-me@localhost:5432/admon
# DB_PASSWORD=change-me
